<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <springProperty name="APP_ENV" source="app.env" defaultValue="local"/>
    <springProperty name="APP_NAME" source="spring.application.name" defaultValue="backend"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <timeZone>UTC</timeZone>
            <timestampPattern>yyyy-MM-dd'T'HH:mm:ss.SSS'Z'</timestampPattern>
            <customFields>{"service":"${APP_NAME}","env":"${APP_ENV}"}</customFields>
            <includeMdc>true</includeMdc>
            <fieldNames>
                <timestamp>timestamp</timestamp>
                <logger>logger</logger>
                <version>[ignore]</version>
                <levelValue>[ignore]</levelValue>
            </fieldNames>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
    <logger name="com.backend" level="INFO"/>
</configuration>
